// ClimateSense — Prisma Schema
// Postgres via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ENUM ----------
enum Role {
  INDIVIDUAL
  ORG_MEMBER
  ORG_ADMIN
  SYSTEM_ADMIN
}

enum AssessmentCategory {
  TRANSPORT
  ENERGY
  DIET
  SHOPPING
  WASTE
  WATER
  OTHER
}

enum RiskType {
  HEAT
  FLOOD
  DROUGHT
  WILDFIRE
  CYCLONE
  SEA_LEVEL
  AIR_QUALITY
  OTHER
}

enum RiskLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum RecommendationSource {
  RULE_BASED
  AI
  ML
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// ---------- USERS, PROFILES, AUTH ----------
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(INDIVIDUAL)
  passwordHash   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        Profile?
  organizations  OrganizationMember[]
  assessments    ClimateAssessment[]
  goals          ClimateGoal[]
  progress       ProgressRecord[]
  conversations  AIConversation[]
  auditLogs      AuditLog[]
  climateRisks   ClimateRiskAssessment[]
  notifications  Notification[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  location       String?
  countryCode    String?
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  units          String?  @default("metric") // metric | imperial
  themePreference String? @default("system") // light | dark | system
  notificationsOn Boolean  @default(true)
  emailOnUpdates Boolean   @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- ORGANIZATIONS ----------
model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  description   String?
  website       String?
  industry      String?
  size          String?
  logo          String?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  members       OrganizationMember[]
  goals         ClimateGoal[]
  audits        AuditLog[]

  @@index([slug])
}

model OrganizationMember {
  id              String       @id @default(cuid())
  organizationId  String
  userId          String
  role            Role         @default(ORG_MEMBER)
  joinedAt        DateTime     @default(now())
  leftAt          DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------- EMISSION FACTORS (REFERENCE DATA) ----------
model EmissionFactor {
  id             String            @id @default(cuid())
  name           String
  category       AssessmentCategory
  activityUnit   String // e.g., "km", "kWh", "kg"
  co2ePerUnit    Decimal           @db.Decimal(12, 6) // kg CO2e per unit
  source         String?           // document reference
  countryCode    String?
  region         String?
  validFrom      DateTime?
  validTo        DateTime?
  isDemo         Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([category])
  @@index([isDemo])
}

// ---------- CLIMATE ASSESSMENTS / ACTIVITIES ----------
model ClimateAssessment {
  id              String               @id @default(cuid())
  userId          String
  title           String
  periodStart     DateTime
  periodEnd       DateTime
  totalCo2eKg     Decimal              @db.Decimal(14, 4)
  dataSource      String               @default("calculator") // calculator | import | manual | api
  notes           String?
  isEstimate      Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities      ClimateActivity[]
  predictions     ClimatePrediction[]
  recommendations Recommendation[]

  @@index([userId])
  @@index([userId, periodStart, periodEnd])
}

model ClimateActivity {
  id                 String              @id @default(cuid())
  assessmentId       String
  category           AssessmentCategory
  subcategory        String?
  description        String?
  activityAmount     Decimal             @db.Decimal(14, 4)
  activityUnit       String
  emissionFactorId   String?
  co2eKg             Decimal             @db.Decimal(14, 4)
  emissionFactorUsed Decimal?            @db.Decimal(12, 6)
  source             String?
  recordedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  assessment         ClimateAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  emissionFactor     EmissionFactor?     @relation(fields: [emissionFactorId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@index([category])
}

// ---------- GOALS & ACTION PLANS ----------
model ClimateGoal {
  id             String               @id @default(cuid())
  title          String
  description    String?
  userId         String?
  organizationId String?
  category       AssessmentCategory?
  // Targets
  targetMetric   String // e.g., "footprint_co2e_kg", "pct_reduction", "actions_completed"
  targetValue    Decimal              @db.Decimal(14, 4)
  baselineValue  Decimal?             @db.Decimal(14, 4)
  currentValue   Decimal              @default(0) @db.Decimal(14, 4)
  unit           String
  status         GoalStatus           @default(NOT_STARTED)
  deadline       DateTime
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionPlans    ActionPlan[]
  progressRecord ProgressRecord[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model ActionPlan {
  id          String         @id @default(cuid())
  goalId      String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  goal        ClimateGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  items       ActionItem[]

  @@index([goalId])
}

model ActionItem {
  id          String            @id @default(cuid())
  planId      String
  title       String
  description String?
  priority    Int?
  dueDate     DateTime?
  status      ActionItemStatus  @default(PENDING)
  completedAt DateTime?
  co2eSavingKg Decimal?         @db.Decimal(14, 4)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  plan        ActionPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

model ProgressRecord {
  id        String        @id @default(cuid())
  goalId    String?
  userId    String?
  value     Decimal       @db.Decimal(14, 4)
  note      String?
  recordedAt DateTime      @default(now())
  createdAt DateTime      @default(now())

  goal      ClimateGoal?  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

// ---------- RECOMMENDATIONS ----------
model Recommendation {
  id              String               @id @default(cuid())
  userId          String?
  assessmentId    String?
  category        AssessmentCategory?
  title           String
  description     String               @db.Text
  impact          String?              // HIGH | MEDIUM | LOW
  estimatedCo2eSavingKg Decimal?      @db.Decimal(14, 4)
  effortLevel     String?              // EASY | MEDIUM | HARD
  source          RecommendationSource @default(RULE_BASED)
  aiModelUsed     String?
  isUserDismissed Boolean              @default(false)
  isCompleted     Boolean              @default(false)
  createdAt       DateTime             @default(now())

  assessment      ClimateAssessment?   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([source])
  @@index([assessmentId])
}

// ---------- ML PREDICTIONS ----------
model ClimatePrediction {
  id                String          @id @default(cuid())
  userId            String?
  assessmentId      String?
  predictionType    String          // e.g., "FOOTPRINT_6M", "FOOTPRINT_12M", "GOAL_PROBABILITY"
  modelVersion      String
  predictedValue    Decimal         @db.Decimal(14, 4)
  unit              String
  confidence        ConfidenceLevel @default(MEDIUM)
  lowerBound        Decimal?        @db.Decimal(14, 4)
  upperBound        Decimal?        @db.Decimal(14, 4)
  targetDate        DateTime
  inputsSnapshot    Json?
  isDemo            Boolean         @default(false)
  createdAt         DateTime        @default(now())

  assessment        ClimateAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentId])
  @@index([isDemo])
}

// ---------- CLIMATE RISK ----------
model ClimateRiskAssessment {
  id          String     @id @default(cuid())
  userId      String?
  location    String
  countryCode String?
  latitude    Decimal?   @db.Decimal(9, 6)
  longitude   Decimal?   @db.Decimal(9, 6)
  riskType    RiskType
  level       RiskLevel
  explanation String     @db.Text
  horizon     String     // e.g., "2030", "2050", "CURRENT"
  source      String?
  isDemo      Boolean    @default(false)
  assessedAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([location, riskType])
  @@index([isDemo])
}

// ---------- AI ASSISTANT ----------
model AIConversation {
  id          String       @id @default(cuid())
  userId      String
  title       String?
  contextHint String?      // e.g., "GOAL_REVIEW", "CALCULATOR_HELP"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]

  @@index([userId])
}

model AIMessage {
  id              String           @id @default(cuid())
  conversationId  String
  role            String           // "user" | "assistant" | "system"
  content         String           @db.Text
  tokensUsed      Int?
  modelUsed       String?
  referencesUsed  Json?
  createdAt       DateTime         @default(now())

  conversation    AIConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------- NOTIFICATIONS ----------
model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // "GOAL_REMINDER" | "RISK_UPDATE" | "ACHIEVEMENT" | "SYSTEM"
  title      String
  body       String?  @db.Text
  linkUrl    String?
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------- REPORTS ----------
model Report {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  type           String   // "personal_monthly" | "org_quarterly" | "sdg_impact"
  title          String
  format         String   // "PDF" | "HTML" | "JSON"
  storageUrl     String?
  periodStart    DateTime?
  periodEnd      DateTime?
  snapshot       Json?
  isGenerated    Boolean  @default(false)
  generatedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
}

// ---------- AUDIT LOG ----------
model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorOrgId     String?
  action         String   // e.g., "USER_CREATED", "GOAL_UPDATED", "ASSESSMENT_DELETED"
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  user           User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [actorOrgId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

// ---------- DATASET (for admin-managed reference data) ----------
model Dataset {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  dataType     String   // "emission_factors" | "risk_regions" | "demo_mock"
  version      String
  source       String?
  isActive     Boolean  @default(true)
  records      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
